def astar(graph, heuristic, start, goal):
    open_list = [(heuristic[start], 0, start, [start])]
    visited = set()

    while open_list:
        open_list.sort()
        f, cost, node, path = open_list.pop(0)

        if node == goal:
            return path, cost

        if node in visited:
            continue

        visited.add(node)

        for neighbour, weight in graph[node]:
            if neighbour not in visited:
                new_cost = cost + weight
                new_f = new_cost + heuristic[neighbour]

                open_list.append(
                    (new_f, new_cost, neighbour,
                     path + [neighbour])
                )

    return None, float('inf')


graph = {}
heuristic = {}

n = int(input("Enter number of nodes: "))

for i in range(n):
    node = input("Enter node name: ")
    graph[node] = []

for i in range(n):
    node = input("Enter source node for edges: ")
    count = int(input("Enter number of outgoing edges: "))

    for j in range(count):
        neighbour = input("Enter destination node: ")
        weight = int(input("Enter edge cost: "))
        graph[node].append((neighbour, weight))

for node in graph:
    heuristic[node] = int(input("Enter heuristic for " + node + ": "))

start = input("Enter starting node: ")
goal = input("Enter goal node: ")

if start in graph and goal in graph:
    path, cost = astar(graph, heuristic, start, goal)
    print("Path:", path)
    print("Cost:", cost)
else:
    print("Invalid start or goal node")
