def minimax(tree, maximizing):
    if isinstance(tree, int):
        return tree

    if maximizing:
        best = float('-inf')

        for child in tree:
            best = max(best, minimax(child, False))

        return best

    else:
        best = float('inf')

        for child in tree:
            best = min(best, minimax(child, True))

        return best


tree = []

for i in range(3):
    print("Enter values for move", i + 1)
    a = int(input("Enter first outcome: "))
    b = int(input("Enter second outcome: "))
    tree.append([a, b])

print("Optimal Value:", minimax(tree, True))
