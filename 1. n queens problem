def solve(board, row):
    if row == 8:
        return True

    for col in range(8):
        safe = True

        for i in range(row):
            if (board[i] == col or
                abs(board[i] - col) == abs(i - row)):
                safe = False
                break

        if safe:
            board[row] = col

            if solve(board, row + 1):
                return True

            board[row] = -1

    return False


board = [-1] * 8

choice = input("Find a solution for 8 queens? (yes/no): ")

if choice.lower() == "yes":
    if solve(board, 0):
        for i in range(8):
            for j in range(8):
                if board[i] == j:
                    print("Q", end=" ")
                else:
                    print(".", end=" ")
            print()
    else:
        print("No solution")
else:
    print("Program stopped")
