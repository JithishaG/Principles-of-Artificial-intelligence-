from collections import deque


def read_state(message):
    value = input(message)
    stacks = []

    for stack in value.split(";"):
        blocks = stack.strip()

        if blocks:
            stacks.append(tuple(blocks.split(",")))

    return tuple(stacks)


def normalize(state):
    return tuple(sorted(state))


def get_moves(state):
    stacks = [list(s) for s in state]

    for i in range(len(stacks)):
        if not stacks[i]:
            continue

        block = stacks[i][-1]
        remaining = [s[:] for s in stacks]
        remaining[i].pop()

        if not remaining[i]:
            remaining.pop(i)

        for j in range(len(remaining) + 1):
            new_stacks = [s[:] for s in remaining]
            new_stacks.insert(j, [block])
            yield normalize(new_stacks)


def bfs(start, goal):
    start = normalize(start)
    goal = normalize(goal)

    queue = deque([(start, [start])])
    visited = {start}

    while queue:
        state, path = queue.popleft()

        if state == goal:
            return path

        for new_state in get_moves(state):
            if new_state not in visited:
                visited.add(new_state)
                queue.append((new_state, path + [new_state]))

    return None


start = read_state("Enter initial stacks: ")
goal = read_state("Enter goal stacks: ")

path = bfs(start, goal)

if path:
    for step, state in enumerate(path):
        print("Step", step, ":", state)
else:
    print("Goal cannot be reached")
